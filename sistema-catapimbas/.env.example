# Ativa login e CRUD de cadastro/vínculos/pessoas pela API legada em português.
VITE_AUTH_MODE=api
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1

# Em produção, hospede o backend Node separadamente e aponte para a URL HTTPS dele:
# VITE_API_BASE_URL=https://api.seudominio.com/api/v1
# Nunca coloque SUPABASE_SECRET_KEY nem SUPABASE_SERVICE_ROLE_KEY em variáveis VITE_*.
